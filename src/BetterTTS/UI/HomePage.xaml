<Page
    x:Class="BetterTTS.UI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Home">
    <StackPanel Margin="24,8,40,32">
        <TextBlock Style="{StaticResource PageTitle}" Text="Home" />

        <Border Padding="24" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="80" Height="80" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusRing" Width="80" Height="80" Opacity="0.25" />
                    <Ellipse x:Name="StatusCircle" Width="64" Height="64" />
                    <ui:SymbolIcon
                        x:Name="StatusIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Filled="True"
                        FontSize="28"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        Symbol="Mic24" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusTitle" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel x:Name="Wave" Height="26" Margin="16,0,8,0" VerticalAlignment="Center" Orientation="Horizontal" />
                        <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <WrapPanel x:Name="HintPanel" Margin="0,8,0,0" />
                    <WrapPanel x:Name="Chips" Margin="0,12,0,0" />
                </StackPanel>

                <ui:Button
                    x:Name="ActionButton"
                    Grid.Column="2"
                    MinWidth="140"
                    Padding="20,8"
                    VerticalAlignment="Center"
                    Click="OnAction"
                    FontWeight="SemiBold" />
            </Grid>
        </Border>

        <UniformGrid Margin="0,8,-8,0" Columns="3">
            <Border Margin="0,0,8,0" Padding="20,16" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Dictations" />
                    <TextBlock x:Name="DictationsValue" Margin="0,4" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="since installing" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="20,16" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Filler words removed" />
                    <TextBlock x:Name="RemovedValue" Margin="0,4" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="um, uh, like, repeats…" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,8,0" Padding="20,16" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Tokens saved (est.)" />
                    <TextBlock x:Name="TokensValue" Margin="0,4" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="about 1.3 tokens per word" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Margin="0,20,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Recent dictations" />
            <TextBlock Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Last 3 · kept on this PC only" />
            <ui:Button x:Name="ClearButton" Grid.Column="2" Appearance="Transparent" Click="OnClear" Content="Clear" />
        </Grid>
        <StackPanel x:Name="RecentList" />
        <TextBlock x:Name="RecentEmpty" Margin="4,4,0,0" Style="{StaticResource Caption}" Text="Your last three dictations will appear here." />
    </StackPanel>
</Page>
