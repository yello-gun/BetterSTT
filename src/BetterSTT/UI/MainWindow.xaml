<ui:FluentWindow
    x:Class="BetterSTT.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:BetterSTT.UI"
    Title="BetterSTT"
    Width="1100"
    Height="780"
    MinWidth="860"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Assets/BetterSTT.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BetterSTT">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/BetterSTT.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Shown when a new version has been downloaded.  -->
        <Border
            x:Name="UpdateBanner"
            Grid.Row="1"
            Margin="12,0,12,8"
            Padding="16,10"
            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ArrowCircleUp24" Filled="True" />
                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Text="Click to install it now. If you don't, it installs automatically the next time you open the app." />
                </StackPanel>
                <ui:Button x:Name="UpdateButton" Grid.Column="2" Appearance="Primary" Click="OnInstallUpdate" Content="Install and restart" />
                <ui:Button Grid.Column="3" Margin="4,0,0,0" Appearance="Transparent" Click="OnHideUpdate" Icon="{ui:SymbolIcon Dismiss16}" ToolTip="Not now" AutomationProperties.Name="Hide the update message" />
            </Grid>
        </Border>

        <ui:NavigationView
            x:Name="Nav"
            Grid.Row="2"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="248"
            FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type local:HomePage}" />
                <ui:NavigationViewItem Content="Style" Icon="{ui:SymbolIcon TextEditStyle24}" TargetPageType="{x:Type local:StylePage}" />
                <ui:NavigationViewItem Content="Dictionary" Icon="{ui:SymbolIcon BookLetter24}" TargetPageType="{x:Type local:DictionaryPage}" />
                <ui:NavigationViewItem Content="Apps" Icon="{ui:SymbolIcon WindowApps24}" TargetPageType="{x:Type local:AppsPage}" />
                <ui:NavigationViewItem Content="Speech" Icon="{ui:SymbolIcon Mic24}" TargetPageType="{x:Type local:SpeechPage}" />
                <ui:NavigationViewItem Content="General" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type local:GeneralPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.PaneFooter>
                <StackPanel Margin="18,0,12,16" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
