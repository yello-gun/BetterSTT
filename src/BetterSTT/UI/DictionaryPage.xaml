<Page
    x:Class="BetterSTT.UI.DictionaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Dictionary">
    <StackPanel Margin="24,8,40,32">
        <TextBlock Style="{StaticResource PageTitle}" Text="Dictionary" />

        <Border Padding="24,18" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Add a word fix" />
                <TextBlock Margin="0,2,0,14" Style="{StaticResource Caption}" Text="When BetterSTT hears the first spelling, it types the second. Fixed words are also given to the speech model as hints, so it hears them right more often. You can also fix a word straight from a recent dictation on Home." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="FromBox" AutomationProperties.Name="Heard as" PlaceholderText="Heard as, e.g. git hub" />
                    <ui:SymbolIcon Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowRight24" />
                    <ui:TextBox x:Name="ToBox" Grid.Column="2" AutomationProperties.Name="Should be" PlaceholderText="Should be, e.g. GitHub" />
                    <ui:Button x:Name="AddButton" Grid.Column="3" Margin="12,0,0,0" Appearance="Primary" Click="OnAdd" Content="Add" Icon="{ui:SymbolIcon Add24}" />
                </Grid>
                <TextBlock x:Name="AddError" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Style="{StaticResource Caption}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Margin="0,8,0,4" Padding="24,18" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Words it should know" />
                <TextBlock Margin="0,2,0,10" Style="{StaticResource Caption}" Text="Names, products and jargon it should spell right even before it ever gets them wrong. Separate with commas." />
                <ui:TextBox x:Name="VocabularyBox" AutomationProperties.Name="Words it should know" MinLines="2" PlaceholderText="e.g. Claude, Kubernetes, Sarah Nguyen" TextWrapping="Wrap" AcceptsReturn="False" />
            </StackPanel>
        </Border>

        <Grid Margin="0,20,0,8">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Word fixes" />
            <TextBlock x:Name="CountText" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
        </Grid>
        <StackPanel x:Name="List" />
        <TextBlock x:Name="EmptyText" Margin="4,4,0,0" Style="{StaticResource Caption}" Text="No word fixes yet." />

        <Grid Margin="0,28,0,8">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Snippets" />
            <TextBlock x:Name="SnippetCountText" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
        </Grid>
        <Border Padding="24,18" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Add a snippet" />
                <TextBlock Margin="0,2,0,14" Style="{StaticResource Caption}" Text="Say the trigger on its own, as a whole dictation, and BetterSTT types the saved text instead. The text can have several lines, like an address or a signature." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TriggerBox" VerticalAlignment="Top" AutomationProperties.Name="Snippet trigger" PlaceholderText="When I say, e.g. my email" />
                    <ui:SymbolIcon Grid.Column="1" Margin="12,8,12,0" VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="ArrowRight24" />
                    <ui:TextBox x:Name="SnippetTextBox" Grid.Column="2" MinLines="2" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Snippet text" PlaceholderText="Type this, e.g. sam@example.com" />
                    <ui:Button Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Primary" Click="OnAddSnippet" Content="Add" Icon="{ui:SymbolIcon Add24}" AutomationProperties.Name="Add snippet" />
                </Grid>
                <TextBlock x:Name="SnippetError" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Style="{StaticResource Caption}" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="SnippetList" />
        <TextBlock x:Name="SnippetEmptyText" Margin="4,4,0,0" Style="{StaticResource Caption}" Text="No snippets yet." />
    </StackPanel>
</Page>
