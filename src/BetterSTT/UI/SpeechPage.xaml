<Page
    x:Class="BetterSTT.UI.SpeechPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Speech">
    <StackPanel Margin="24,8,40,32">
        <TextBlock Style="{StaticResource PageTitle}" Text="Speech" />

        <Border Padding="20,16" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="EngineTile" Style="{StaticResource IconTile}">
                    <ui:SymbolIcon x:Name="EngineIcon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Symbol="DeveloperBoard24" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="EngineTitle" Style="{StaticResource Body}" />
                    <TextBlock x:Name="EngineDetail" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button x:Name="RestartButton" Margin="0,0,12,0" Appearance="Primary" Click="OnRestart" Content="Restart to apply" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Use GPU" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="GpuSwitch" Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="Use GPU" />
            </Grid>
        </Border>

        <Grid Margin="0,20,0,8">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Model" />
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}" Text="Bigger models are more accurate. Models download once, the first time you pick them." />
        </Grid>
        <StackPanel x:Name="ModelList" />

        <Border Margin="0,4,0,4" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Free memory when idle" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="Unloads the model after a while without dictating. The next dictation takes a second or two longer while it reloads." />
                </StackPanel>
                <ComboBox x:Name="UnloadBox" Grid.Column="1" MinWidth="200" Margin="16,0,0,0" AutomationProperties.Name="Free memory when idle" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Recognition" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Language" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="Choose “Detect automatically” if you switch between languages." />
                </StackPanel>
                <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="220" AutomationProperties.Name="Language" DisplayMemberPath="Name" />
            </Grid>
        </Border>
        <TextBlock Margin="4,4,0,0" Style="{StaticResource Caption}" Text="Names and jargon it should spell right are on the Dictionary page." />
    </StackPanel>
</Page>
