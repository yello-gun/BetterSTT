<Page
    x:Class="BetterSTT.UI.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="General">
    <StackPanel Margin="24,8,40,32">
        <TextBlock Style="{StaticResource PageTitle}" Text="General" />

        <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="Dictation" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Shortcut" />
                    <TextBlock x:Name="ShortcutHint" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <ContentControl x:Name="ShortcutKeys" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" />
                <ui:Button x:Name="ChangeButton" Grid.Column="2" MinWidth="90" Click="OnChangeShortcut" Content="Change" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="How the shortcut works" />
                    <TextBlock x:Name="ActivationHint" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="ToggleModeButton" MinWidth="110" Click="OnToggleMode" Content="Press to start" />
                        <ui:Button x:Name="HoldModeButton" MinWidth="110" Margin="2,0,0,0" Click="OnHoldMode" Content="Hold to talk" />
                        <ui:Button x:Name="HandsFreeModeButton" MinWidth="110" Margin="2,0,0,0" Click="OnHandsFreeMode" Content="Hands-free" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Paste last dictation" />
                    <TextBlock x:Name="PasteLastHint" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <ContentControl x:Name="PasteLastKeys" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" />
                <ui:Button x:Name="PasteLastChangeButton" Grid.Column="2" MinWidth="90" Margin="0,0,16,0" Click="OnChangePasteLast" Content="Change" />
                <ui:ToggleSwitch x:Name="PasteLastSwitch" Grid.Column="3" VerticalAlignment="Center" AutomationProperties.Name="Paste last dictation shortcut" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Keep listening after you stop" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="Records a moment longer so your last word isn't cut off." />
                </StackPanel>
                <ComboBox x:Name="TailBox" Grid.Column="1" MinWidth="180" AutomationProperties.Name="Keep listening after you stop" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="Microphone" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="Speak to check the level." />
                    </StackPanel>
                    <ComboBox x:Name="MicBox" Grid.Column="1" MinWidth="300" AutomationProperties.Name="Microphone" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Mic24" />
                    <Border x:Name="MeterTrack" Grid.Column="1" Height="6" Margin="12,0" VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="3">
                        <Border x:Name="MeterFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource SystemFillColorSuccessBrush}" CornerRadius="3" />
                    </Border>
                    <TextBlock x:Name="MeterLabel" Grid.Column="2" Width="60" VerticalAlignment="Center" Style="{StaticResource Caption}" TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="How text is entered" />
                    <TextBlock x:Name="OutputHint" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="PasteButton" MinWidth="80" Click="OnPaste" Content="Paste" />
                        <ui:Button x:Name="TypeButton" MinWidth="80" Margin="2,0,0,0" Click="OnType" Content="Type" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Behavior" />
        <StackPanel x:Name="Toggles" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="Listening indicator" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="A small pill on screen while you talk. It can also be hidden for specific apps on the Apps page." />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="OverlaySwitch" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Listening indicator" />
                </Grid>
                <StackPanel x:Name="OverlayDetails" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Body}" Text="Show words as you speak" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="A live draft in the pill. The final text is produced when you stop." />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="LivePreviewSwitch" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Show words as you speak" />
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Position" />
                        <ComboBox x:Name="PositionBox" MinWidth="150" Margin="0,0,8,0" AutomationProperties.Name="Indicator position" />
                        <ComboBox x:Name="ScreenBox" MinWidth="170" Margin="0,0,8,0" AutomationProperties.Name="Indicator screen" />
                        <ui:Button Click="OnPreviewOverlay" Content="Preview" Icon="{ui:SymbolIcon Eye24}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Updates and help" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Check for updates automatically" />
                    <TextBlock x:Name="UpdateStatus" Margin="0,2,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
                <ui:Button x:Name="CheckButton" Grid.Column="1" MinWidth="110" Margin="16,0" Click="OnCheckUpdates" Content="Check now" />
                <ui:ToggleSwitch x:Name="UpdateSwitch" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Check for updates automatically" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" Text="Save diagnostics" />
                    <TextBlock x:Name="DiagnosticsHint" Margin="0,2,16,0" Style="{StaticResource Caption}" Text="For a bug report: a .zip with the log, your Windows version and GPU, and your settings. It never includes anything you dictated, and your word fixes, snippets and vocabulary are hidden." />
                </StackPanel>
                <ui:Button Grid.Column="1" MinWidth="110" Click="OnSaveDiagnostics" Content="Save…" Icon="{ui:SymbolIcon Save24}" />
            </Grid>
        </Border>

        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="AboutText" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Click="OnOpenData" Content="Open data folder" />
        </Grid>
    </StackPanel>
</Page>
