<Window
    x:Class="BetterSTT.UI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BetterSTT status"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    IsHitTestVisible="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    Topmost="True"
    WindowStyle="None">
    <Border
        x:Name="Pill"
        Height="48"
        Margin="24"
        Padding="16,0,20,0"
        BorderThickness="1"
        CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" BlurRadius="24" Direction="270" Opacity="0.3" ShadowDepth="6" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Grid Width="22" Height="22" VerticalAlignment="Center">
                <Ellipse x:Name="RecDot" Width="10" Height="10" />
                <Ellipse x:Name="RecHalo" Width="18" Height="18" Opacity="0.25" />
                <Grid x:Name="Spinner" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Grid.RenderTransform>
                    <Ellipse x:Name="SpinnerTrack" Width="18" Height="18" StrokeThickness="2.4" />
                    <Path x:Name="SpinnerArc" Data="M 11,2 A 9,9 0 0 1 20,11" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="2.4" />
                </Grid>
                <Grid x:Name="Check">
                    <Ellipse x:Name="CheckCircle" Width="22" Height="22" />
                    <Path x:Name="CheckMark" Data="M 6.5,11.5 L 9.8,14.6 L 15.8,7.8" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2.2" />
                </Grid>
            </Grid>
            <StackPanel x:Name="Wave" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" />
            <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="DetailText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
            <StackPanel x:Name="StopHint" VerticalAlignment="Center" Orientation="Horizontal">
                <Rectangle x:Name="Separator" Width="1" Height="20" Margin="12,0" />
                <StackPanel x:Name="Keys" VerticalAlignment="Center" Orientation="Horizontal" />
                <TextBlock x:Name="StopText" Margin="2,0,0,0" VerticalAlignment="Center" FontSize="12" Text="to stop" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
